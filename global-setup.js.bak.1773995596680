import { chromium } from "@playwright/test";
import fs from "fs";
import { createInterface } from "readline/promises";
import { stdin as input, stdout as output } from "process";

export default async function globalSetup() {
  console.log("[global-setup] Starting authentication setup...");
  const browser = await chromium.launch({ args: ['--force-device-scale-factor=1', '--high-dpi-support=1', '--start-maximized'] });
  // When using a null viewport we cannot pass deviceScaleFactor — omit it here
  const context = await browser.newContext({ viewport: null });

  // Default OIDC values (used when no env or UI-provided values exist)
  const defaultOidcKey = "oidc.user:https://login-new.accionbreeze.com/realms/accionlabswebsite:isometric";
  let defaultOidcValue = { "id_token": "", "session_state": "", "access_token": "", "refresh_token": "", "token_type": "Bearer", "scope": "openid profile email", "profile": {}, "expires_at": 0 };
  // If there's a safely embedded JSON in an env fallback, attempt to use it
  if (process.env.DEFAULT_OIDC_VALUE) {
    try { defaultOidcValue = JSON.parse(process.env.DEFAULT_OIDC_VALUE); } catch (e) { /* ignore */ }
  }

  // Determine final OIDC key/value from environment variables, interactive input (TTY), or defaults
  let oidcKey = process.env.OIDC_KEY ?? defaultOidcKey;
  let oidcValue = defaultOidcValue;

  if (process.env.OIDC_VALUE) {
    try {
      oidcValue = JSON.parse(process.env.OIDC_VALUE);
    } catch (e) {
      console.warn('[global-setup] Failed to parse OIDC_VALUE env var as JSON. Using default OIDC value.');
    }
  } else if (input && input.isTTY) {
    try {
      const rl = createInterface({ input, output });
      const keyAnswer = (await rl.question(`OIDC Key (press Enter to accept default: ${defaultOidcKey}): `)).trim();
      if (keyAnswer) oidcKey = keyAnswer;
      const valueAnswer = (await rl.question('OIDC Value (paste JSON or press Enter to accept default): ')).trim();
      if (valueAnswer) {
        try {
          oidcValue = JSON.parse(valueAnswer);
        } catch (e) {
          console.warn('[global-setup] Provided OIDC JSON invalid — using default.');
        }
      }
      rl.close();
    } catch (e) {
      // If interactive prompt fails, fall back to env/default silently
    }
  }

  await context.addInitScript(
    ({ key, value }) => {
      sessionStorage.setItem(key, JSON.stringify(value));
    },
    {
      key: oidcKey,
      value: oidcValue
    }
  );

  // Ensure pages open with 100% zoom
  await context.addInitScript(() => {
    try { document.documentElement.style.zoom = '100%'; } catch (e) { }
  });

  // Persist cookies/localStorage for authenticated state
  await context.storageState({ path: "auth.json" });

  // Persist OIDC session data so tests can inject it into sessionStorage before any page loads
  await fs.promises.writeFile(
    "session-auth.json",
    JSON.stringify({ key: oidcKey, value: oidcValue }),
    "utf-8"
  );

  await browser.close();
  console.log("[global-setup] auth.json created, setup complete.");
}
